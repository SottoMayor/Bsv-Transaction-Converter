{
  "name": "bsv-transaction-converter",
  "version": "1.0.0",
  "description": "Bitcoin SV transaction format converter (RAW, EF, BEEF)",
  "author": "David Sotto Mayor <ddsmmf@gmail.com>",
  "keywords": ["bitcoin-sv", "bsv", "transaction", "EF", "BEEF", "BRC-30", "BRC-62"],
  "repository": {
    "type": "git",
    "url": "https://github.com/SottoMayor/Bsv-Transaction-Converter.git"
  },
  "homepage": "https://github.com/SottoMayor/Bsv-Transaction-Converter#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "ef": "tsx src/converters/ef-packager.ts",
    "beef": "tsx src/converters/beef-packager.ts",
    "beef-to-ef": "tsx src/converters/beef-to-ef.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "axios": "^1.13.5"
  }
}
